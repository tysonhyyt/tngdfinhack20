PORT=3000
KAFKA_BOOTSTRAP_SERVERS=alikafka-post-public-intl-sg-jiy4r8p3903-1.alikafka.aliyuncs.com:9093,alikafka-post-public-intl-sg-jiy4r8p3903-2.alikafka.aliyuncs.com:9093,alikafka-post-public-intl-sg-jiy4r8p3903-3.alikafka.aliyuncs.com:9093
KAFKA_CLIENT_ID=backend-api-ingress
KAFKA_SSL=true
KAFKA_SSL_REJECT_UNAUTHORIZED=true
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=your-sasl-username
KAFKA_SASL_PASSWORD=your-sasl-password
KAFKAJS_NO_PARTITIONER_WARNING=1
KAFKA_TOPIC=offline.transact.sync
KAFKA_CONSUMER_GROUP=your-consumer-group-id
# If true, consumer reads from the beginning of the topic (use only when you intend a full replay).
KAFKA_CONSUMER_FROM_BEGINNING=false
# Optional: when set, reserved for outbound webhook / downstream API (see kafkaConsumer.handler.ts).

# --- AWS Bedrock (see src/infrastructure/bedrock.service.ts) ---
# Region where the model is available (must match Bedrock console region).
AWS_REGION=us-east-1
# Optional: overrides AWS_REGION for Bedrock only.
# BEDROCK_REGION=
# Model or inference profile ID from Bedrock (enable model access in console first).
BEDROCK_MODEL_ID=anthropic.claude-3-5-haiku-20241022-v1:0
# Optional default max output tokens for Converse (default 1024).
BEDROCK_MAX_TOKENS=1024
# Optional static credentials; on EC2/Lambda/ECS omit and use instance/task role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=