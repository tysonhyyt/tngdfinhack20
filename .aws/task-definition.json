{
  "family": "tngdfinhack20-backend",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::372206266092:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "tngdfinhack20-backend",
      "image": "<ECR_IMAGE_PLACEHOLDER>",
      "portMappings": [
        {
          "containerPort": 3000,
          "protocol": "tcp"
        }
      ],
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/tngdfinhack20-backend",
          "awslogs-region": "ap-southeast-5",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      },
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        }
      ]
    }
  ]
}